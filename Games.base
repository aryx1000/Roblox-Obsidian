filters:
  and:
    - file.inFolder("Games")
    - file.hasTag("game")
    - file.ext == "md"
formulas:
  docs: file.links.length
  updated: file.mtime.format("YYYY-MM-DD")
  days_since_update: (now() - file.mtime).days
properties:
  file.name:
    displayName: Game
  status:
    displayName: Status
  owner:
    displayName: Owner
  formula.docs:
    displayName: Links
  formula.updated:
    displayName: Hub updated
  formula.days_since_update:
    displayName: Days since update
views:
  - type: table
    name: All games
    order:
      - file.name
      - status
      - owner
      - formula.docs
      - formula.updated
  - type: cards
    name: Game cards
    order:
      - file.name
      - status
      - formula.days_since_update
